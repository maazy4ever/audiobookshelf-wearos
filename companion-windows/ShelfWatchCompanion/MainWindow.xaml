<Window x:Class="ShelfWatchCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShelfWatch Companion" Height="700" Width="1000" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <!-- Verbindung zur Uhr -->
        <GroupBox DockPanel.Dock="Top" Header="Pixel Watch" Padding="6">
            <StackPanel>
                <WrapPanel>
                    <Label Content="IP:" />
                    <TextBox x:Name="WatchIp" Width="130" />
                    <Label Content="Port:" />
                    <TextBox x:Name="WatchPort" Width="60" />
                    <Label Content="Code:" />
                    <PasswordBox x:Name="WatchPin" Width="90" />
                    <Button x:Name="DiscoverBtn" Content="Uhr suchen" Click="Discover_Click" />
                    <Button x:Name="ConnectBtn" Content="Verbinden" Click="Connect_Click" FontWeight="SemiBold" />
                </WrapPanel>
                <TextBlock x:Name="WatchStatusText" Margin="4,8,0,0" TextWrapping="Wrap"
                           Text="Nicht verbunden. Auf der Uhr: ShelfWatch → PC-Verbindung einschalten, dann „Uhr suchen“ und den angezeigten Code eingeben." />
            </StackPanel>
        </GroupBox>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="0,8,0,0">

            <!-- Downloads auf der Uhr -->
            <TabItem Header="Auf der Uhr">
                <DockPanel Margin="6">
                    <TextBlock x:Name="NowPlayingText" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Ausgewählte entfernen / abbrechen" Click="RemoveDownload_Click" />
                        <Button Content="Aktualisieren" Click="Refresh_Click" />
                        <TextBlock x:Name="StorageText" VerticalAlignment="Center" Margin="12,0" />
                    </WrapPanel>
                    <DataGrid x:Name="DownloadsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*" />
                            <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="90" />
                            <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="80" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="170" />
                            <DataGridTemplateColumn Header="Fortschritt" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="18"
                                                         Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Konto & Bibliothek -->
            <TabItem Header="Bibliothek &amp; Konto">
                <DockPanel Margin="6">
                    <GroupBox DockPanel.Dock="Top" Header="Audiobookshelf-Konto" Padding="6">
                        <StackPanel>
                            <WrapPanel>
                                <Label Content="Server:" />
                                <TextBox x:Name="AbsServer" Width="240" />
                                <Label Content="Benutzer:" />
                                <TextBox x:Name="AbsUser" Width="120" />
                                <Label Content="Passwort:" />
                                <PasswordBox x:Name="AbsPassword" Width="120" />
                                <Button Content="Anmelden" Click="AbsLogin_Click" />
                                <Button Content="Auf Uhr anmelden" Click="WatchLogin_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="AbsStatusText" Margin="4,6,0,0" TextWrapping="Wrap"
                                       Text="Zugangsdaten werden verschlüsselt (Windows-DPAPI) gespeichert." />
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,6">
                        <Label Content="Bibliothek:" />
                        <ComboBox x:Name="LibraryBox" Width="200" SelectionChanged="Library_Changed" />
                        <Label Content="Suche:" Margin="12,0,0,0" />
                        <TextBox x:Name="SearchBox" Width="220" KeyDown="Search_KeyDown" />
                        <Button Content="Suchen" Click="Search_Click" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Auf Uhr herunterladen" Click="DownloadToWatch_Click" FontWeight="SemiBold" />
                        <Button x:Name="MoreBtn" Content="Mehr laden" Click="More_Click" IsEnabled="False" />
                        <TextBlock x:Name="LibCountText" VerticalAlignment="Center" Margin="12,0" />
                    </WrapPanel>
                    <DataGrid x:Name="BooksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended"
                              GridLinesVisibility="Horizontal" MouseDoubleClick="Books_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*" />
                            <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="90" />
                            <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="80" />
                            <DataGridTextColumn Header="Auf der Uhr" Binding="{Binding OnWatch}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
